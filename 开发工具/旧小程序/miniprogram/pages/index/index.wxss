.page {
  min-height: 100vh;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
}

.hero {
  padding: 48rpx 0 0;
}

.hero-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #2563EB;
  background: #EAF1FE;
  border-radius: 6rpx;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 52rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: #1F2329;
}

.hero-desc {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: #6B7280;
}

.stats {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 28rpx 0;
  background: #F7F8FA;
  border-radius: 16rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 500;
  color: #1F2329;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A919F;
}

.stat-line {
  width: 1rpx;
  height: 48rpx;
  background: #E5E7EB;
}

.features {
  margin-top: 44rpx;
}

.feature {
  display: flex;
  padding: 22rpx 0;
}

.feature-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin: 14rpx 20rpx 0 0;
  background: #2563EB;
  border-radius: 50%;
}

.feature-body {
  flex: 1;
}

.feature-title {
  font-size: 29rpx;
  font-weight: 500;
  color: #1F2329;
}

.feature-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #7B828E;
}

.privacy {
  margin-top: 40rpx;
  padding: 24rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8A919F;
  background: #FAFAFA;
  border-radius: 12rpx;
}

.privacy-link {
  color: #2563EB;
}

.footer {
  margin-top: 56rpx;
}

.start-btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: #2563EB;
  border-radius: 12rpx;
}

.start-btn::after {
  border: none;
}

.version {
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #B7BCC4;
  text-align: center;
}
